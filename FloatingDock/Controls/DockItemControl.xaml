<UserControl x:Class="FloatingDock.Controls.DockItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FloatingDock.Converters"
             Cursor="Hand"
             Margin="6,0">
    <UserControl.Resources>
        <converters:ImageSourceConverter x:Key="ImageSourceConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.85"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard x:Name="EnterStoryboard">
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ItemScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.3" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ItemScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.3" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="NameLabel"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard x:Name="LeaveStoryboard">
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ItemScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ItemScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="NameLabel"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.6" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Border x:Name="IconBorder" 
                Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CornerRadius="12"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Image x:Name="IconImage" 
                   Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ImageSourceConverter}}"/>
        </Border>
        <TextBlock x:Name="NameLabel"
                   Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="#B0FFFFFF"
                   FontSize="10"
                   FontFamily="{Binding ItemFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"
                   MaxWidth="64"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.6"
                   Visibility="{Binding ShowLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}"/>
    </StackPanel>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuOpen" Header="打开" Click="MenuOpen_Click"/>
            <MenuItem x:Name="MenuShowInExplorer" Header="在资源管理器中显示" Click="MenuShowInExplorer_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuRemove" Header="从托盘移除" Click="MenuRemove_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
