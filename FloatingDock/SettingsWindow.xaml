<Window x:Class="FloatingDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="托盘设置"
        WindowStyle="SingleBorderWindow"
        Width="520" Height="700"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="托盘设置" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 托盘名称 + 显示开关 -->
                <TextBlock Text="托盘名称（为空则不显示）" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="DockNameBox" FontSize="13" Padding="6,4" Width="300"
                             LostFocus="DockNameBox_LostFocus"/>
                    <CheckBox x:Name="ShowNameCheck" Content="显示名称" Margin="12,0,0,0"
                              FontSize="13" VerticalAlignment="Center"
                              Checked="ShowNameCheck_Changed" Unchecked="ShowNameCheck_Changed"/>
                </StackPanel>

                <!-- 透明度 -->
                <TextBlock Text="背景透明度" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0"
                            Width="260" VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="OpacityValue" Text="85%" Margin="12,0,0,0"
                               FontSize="13" VerticalAlignment="Center" Width="40"/>
                </StackPanel>

                <!-- 背景颜色 -->
                <TextBlock Text="背景颜色" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ColorPreview" Width="40" Height="28"
                            CornerRadius="4" BorderBrush="Gray" BorderThickness="1"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="ColorHexText" Text="#1E1E2E" FontSize="13"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="选择颜色..." Margin="16,0,0,0" Padding="12,4"
                            Click="ChooseColor_Click"/>
                </StackPanel>

                <!-- 圆角 -->
                <TextBlock Text="圆角大小（0 = 直角）" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="40"
                            Width="260" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                            TickFrequency="1" ValueChanged="CornerRadiusSlider_ValueChanged"/>
                    <TextBox x:Name="CornerRadiusValue" Width="50" Margin="12,0,0,0"
                             FontSize="13" Padding="4,2" VerticalAlignment="Center"
                             TextAlignment="Center" LostFocus="CornerRadiusValue_LostFocus"/>
                </StackPanel>

                <!-- 图标大小 -->
                <TextBlock Text="图标大小" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="IconSizeSlider" Minimum="24" Maximum="96"
                            Width="260" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                            TickFrequency="1" ValueChanged="IconSizeSlider_ValueChanged"/>
                    <TextBox x:Name="IconSizeValue" Width="50" Margin="12,0,0,0"
                             FontSize="13" Padding="4,2" VerticalAlignment="Center"
                             TextAlignment="Center" LostFocus="IconSizeValue_LostFocus"/>
                </StackPanel>

                <!-- 显示标签 + 字体 -->
                <CheckBox x:Name="ShowLabelsCheck" Content="显示图标文字"
                          Margin="0,16,0,0" FontSize="13"
                          Checked="ShowLabelsCheck_Changed" Unchecked="ShowLabelsCheck_Changed"/>

                <TextBlock Text="字体" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ComboBox x:Name="FontComboBox" Width="260" HorizontalAlignment="Left"
                          FontSize="13" SelectionChanged="FontComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 方向 -->
                <TextBlock Text="排列方向" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioHorizontal" Content="横向" Margin="0,0,16,0"
                                 Checked="RadioHorizontal_Checked"/>
                    <RadioButton x:Name="RadioVertical" Content="纵向"
                                 Checked="RadioVertical_Checked"/>
                </StackPanel>

                <!-- 开关选项 -->
                <CheckBox x:Name="AutoSnapCheck" Content="自动贴靠屏幕边缘"
                          Margin="0,16,0,0" FontSize="13"
                          Checked="AutoSnapCheck_Changed" Unchecked="AutoSnapCheck_Changed"/>
                <CheckBox x:Name="AlwaysOnTopCheck" Content="始终置顶"
                          Margin="0,8,0,0" FontSize="13"
                          Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>
                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动"
                          Margin="0,8,0,0" FontSize="13"
                          Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>

                <!-- 主题选择 -->
                <TextBlock Text="美术风格" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <WrapPanel x:Name="ThemePanel"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Width="80" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
