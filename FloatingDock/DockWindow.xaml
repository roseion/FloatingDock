<Window x:Class="FloatingDock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatingDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Topmost="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- 多层软阴影（置于 Dock 下方，负Margin外扩） -->
        <Grid x:Name="ShadowLayers" IsHitTestVisible="False"/>

        <!-- Main Dock bar -->
        <Border x:Name="DockBorder"
                CornerRadius="20"
                Background="#CC1E1E2E"
                Padding="12,8"
                MinHeight="76">
            <Grid>
                <!-- 材质叠层：顶部光泽（图标之下） -->
                <Border x:Name="GlossOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
                <!-- 材质叠层：新拟态斜切边框 -->
                <Border x:Name="BevelOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <StackPanel x:Name="OrientationPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <!-- 托盘名称标签 -->
                    <TextBlock x:Name="DockNameLabel"
                               Foreground="#B0FFFFFF"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"/>
                    <Border x:Name="NameSeparator"
                            Width="1" Height="40"
                            Background="#30FFFFFF"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <!-- 图标面板 -->
                    <StackPanel x:Name="ItemsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 材质叠层：CRT扫描线（图标之上） -->
                <Border x:Name="TextureOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Drop indicator overlay -->
        <Border x:Name="DropOverlay"
                CornerRadius="20"
                Background="#30FFFFFF"
                BorderBrush="#60FFFFFF"
                BorderThickness="2"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock Text="拖放快捷方式到此处"
                       Foreground="#80FFFFFF"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Empty state hint -->
        <TextBlock x:Name="EmptyHint"
                   Text="右键添加 或 拖放快捷方式"
                   Foreground="#60FFFFFF"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu" Opened="MainContextMenu_Opened">
            <MenuItem x:Name="MenuToggleTop" Header="取消置顶" Click="MenuToggleTop_Click"/>
            <Separator/>
            <MenuItem Header="添加快捷方式" Click="MenuAddShortcut_Click"/>
            <MenuItem x:Name="MenuRemoveItems" Header="移除项目"/>
            <Separator/>
            <MenuItem Header="设置" Click="MenuSettings_Click"/>
            <MenuItem Header="新建托盘" Click="MenuNewDock_Click"/>
            <MenuItem x:Name="MenuCloseDock" Header="关闭此托盘" Click="MenuCloseDock_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
